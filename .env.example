# Copie para .env e ajuste. O arquivo .env nunca deve ir para o repositório.

# SIMULATED usa a base fictícia. OFFICIAL usa os dados oficiais importados.
DATA_MODE=SIMULATED

# Opcional: caminho do banco. Padrão: data/db/simulado.sqlite ou data/db/oficial.sqlite
# DATABASE_PATH=data/db/simulado.sqlite

# Opcional: pasta com CSV ou .xlsx oficiais, lida na inicialização quando o banco oficial não existe
# OFFICIAL_DATA_DIR=data/oficial

# Opcional: textos exibidos no painel de status
# DATA_SOURCE_LABEL=Dados oficiais da pesquisa
# RESEARCH_STATUS=Dados oficiais incorporados
# APP_VERSION_LABEL=Versão 1.0
